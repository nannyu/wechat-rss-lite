# Copy to .env and fill in values.
ADMIN_API_TOKEN=
# Optional: require ?token= or Bearer on /feeds/*.rss (leave empty for public feeds in dev).
RSS_READ_TOKEN=
SITE_URL=http://127.0.0.1:8081

# Max articles per bulk refresh request (default 50).
REFRESH_BATCH_LIMIT=50

# curl_cffi TLS verification (default true). Set false only if you understand the MITM risk.
# CURL_TLS_VERIFY=true

# Comma-separated image host whitelist for /image proxy.
# ALLOWED_IMAGE_HOSTS=mmbiz.qpic.cn,mmbiz.qlogo.cn,wx.qlogo.cn,res.wx.qq.com
